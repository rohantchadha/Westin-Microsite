{
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "westin-microsite.vercel.app"
        }
      ],
      "destination": "https://www.thewestinresidences.co/",
      "permanent": true
    },
    {
      "source": "/:path+",
      "has": [
        {
          "type": "host",
          "value": "westin-microsite.vercel.app"
        }
      ],
      "destination": "https://www.thewestinresidences.co/:path+",
      "permanent": true
    }
  ]
}
